# Kopie als .env anlegen. .env steht in .gitignore und wird nie eingecheckt.
# Standard ist der Mock-Modus: Er läuft ohne Schlüssel und nur mit fiktiven Daten.
LLM_MODUS=mock
LLM_API_KEY=
# Texterkennung für eigene Fotos (Rolle Kamera): tesseract (Standard, lokal, ohne Internet) oder aus (Text wird eingetippt)
OCR_MODUS=tesseract
